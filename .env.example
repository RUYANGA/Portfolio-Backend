# Backend settings. Copy to .env and fill in.
# Used by Django directly (./scripts/start.sh dev) and by docker-compose.yml on the server.
# Never commit the real .env.

# --- Core -------------------------------------------------------------------
# Production: a long random value. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Environment is chosen by settings module, not a flag: manage.py uses
# config.settings.development, `manage.py test` uses config.settings.test, and
# Docker/gunicorn use config.settings.production. Override with DJANGO_SETTINGS_MODULE.
LOG_LEVEL=INFO

# --- Addresses --------------------------------------------------------------
# Host name(s) the API answers to. Production: api.ruyanga.tech
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public address of this API, used for image and résumé links. Production: https://api.ruyanga.tech
PUBLIC_URL=
DJANGO_CSRF_TRUSTED_ORIGINS=
# The site allowed to call the API from browsers (contact form, live API panel).
# Production: your Vercel domain(s), e.g. https://ruyanga.tech,https://www.ruyanga.tech
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional: allow Vercel preview deployments too (regex, comma-separated).
# e.g. ^https://merci-portfolio-[a-z0-9-]+\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# --- Database ---------------------------------------------------------------
# Local Django → the Docker database (docker compose up -d db). The container ignores this.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5434/portfolio
# Database password used by docker-compose.yml. Production: a strong random value.
POSTGRES_PASSWORD=portfolio

# --- Server -----------------------------------------------------------------
# Docker Hub image published by CI (.github/workflows/backend.yml). Leave empty to build locally.
# e.g. youruser/merci-portfolio-api:latest  (or pin a release: youruser/merci-portfolio-api:sha-1a2b3c4)
API_IMAGE=
# Port the API is published on (put your HTTPS reverse proxy in front of it).
API_PORT=8000
# Serve uploaded images and the résumé from Django. Set false if Nginx serves /media/.
SERVE_MEDIA=true
# Seed missing content on every start. Never overwrites dashboard edits.
AUTO_SEED=true
# How long an admin dashboard sign-in lasts, in seconds (default 7 days).
ADMIN_TOKEN_TTL=604800

# --- Admin account (created on first start, never overwritten) ---------------
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# --- Contact-form email notifications (optional) ------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=
